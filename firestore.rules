// ===============================================================
// ScanTrack Pro — Firestore Security Rules
// ===============================================================
//
// ARCHITECTURE NOTE:
// This application does NOT access Firestore directly from the
// browser. All reads and writes go through the Express API server,
// which uses the Firebase Admin SDK. The Admin SDK bypasses these
// security rules entirely, so the server continues to work no
// matter what is written here.
//
// Because no trusted client path exists, the correct posture is to
// DENY all direct client access. This prevents anyone who obtains
// the public web config and signs in with Firebase Auth (e.g. the
// Google sign-in used for the Sheets importer) from reading or
// writing collections directly and bypassing the server's
// permission checks.
//
// If you ever add direct client Firestore access, scope specific
// per-collection rules here instead of loosening this default.
// ===============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

