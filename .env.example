# .env.example
# REQUIRED in production — app refuses to start without it.
SESSION_SECRET=
# Optional: set the first admin password explicitly. If omitted, a strong
# random password is generated and printed to the server log once on first boot.
INITIAL_ADMIN_PASSWORD=
DATABASE_PATH=
PORT=3000
NODE_ENV=development
RESEND_API_KEY=
REPORT_EMAIL=
MANAGER_EMAIL=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_DATABASE_ID=
